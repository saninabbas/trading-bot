{
  "manifest_version": 3,
  "name": "FUTURES AI – Pro Trader",
  "version": "3.0.0",
  "description": "Automated Binance Futures bot with RSI+EMA, MACD, Scalping & Breakout strategies. Paper & Live trading.",
  "permissions": ["storage", "alarms", "notifications", "tabs"],
  "host_permissions": [
    "https://api.binance.com/*",
    "https://fapi.binance.com/*",
    "https://testnet.binancefuture.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "options_page": "dashboard.html",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
